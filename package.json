{
  "name": "ripple",
  "private": true,
  "description": "Twitch-connected deterministic evolution game shared by streamers and their communities",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -b tsconfig.build.json && npm run build -w @ripple/web",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run --project unit",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run migrate -w @ripple/database",
    "sandbox": "npm run sandbox -w @ripple/server --",
    "metrics": "npm run metrics -w @ripple/server --",
    "replay": "npm run replay -w @ripple/server --",
    "smoke:game": "npm run smoke:game -w @ripple/server",
    "smoke:raids": "npm run smoke:raids -w @ripple/server",
    "smoke:mechanics": "npm run smoke:mechanics -w @ripple/server",
    "smoke:studio": "npm run smoke:studio -w @ripple/server",
    "simulate": "npm run simulate -w @ripple/server --"
  }
}
