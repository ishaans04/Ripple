# Copy to .env for local development outside Docker. Never commit real secrets.

# Application database (the Compose `db` service is published on localhost:55432).
DATABASE_URL=postgres://ripple:ripple@localhost:55432/ripple

# Server listener.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time allowed to drain requests on shutdown before forcing exit.
SHUTDOWN_GRACE_MS=15000

# Built web application served by the API server (run `npm run build` first).
# Leave unset during development and use the Vite dev server on :5173 instead.
# WEB_ROOT=apps/web/dist

# Integration tests create and drop temporary databases through this connection.
TEST_DATABASE_URL=postgres://ripple:ripple@localhost:55432/postgres

# Hosted Twitch integration is off for local evaluation. See docs/twitch-setup.md.
ENABLE_LIVE_TWITCH=false
# PUBLIC_BASE_URL=https://your-stable-app-domain
# TWITCH_REDIRECT_URI=https://your-stable-app-domain/auth/twitch/callback
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_EVENTSUB_SECRET= # 32-100 printable ASCII characters
# TOKEN_ENCRYPTION_KEY= # independently generated 32-byte base64 key
# SESSION_SECRET= # independently generated 32-byte base64 key
# ACTOR_HASH_KEY= # independently generated 32-byte base64 key
# OPERATOR_SECRET= # independently generated secret, at least 32 characters
# RULESET_VERSION=candidate-1
