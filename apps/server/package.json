{
  "name": "@ripple/server",
  "version": "0.0.0",
  "private": true,
  "description": "Ripple application service: HTTP routes, intake, workers, and browser delivery",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --conditions=ripple-source --watch src/main.ts",
    "start": "node dist/main.js",
    "sandbox": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/sandbox.ts",
    "smoke:game": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/smoke-game.ts",
    "smoke:raids": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/smoke-raids.ts",
    "smoke:mechanics": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/smoke-mechanics.ts",
    "metrics": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/metrics.ts",
    "replay": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/replay.ts",
    "smoke:studio": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/smoke-studio.ts",
    "simulate": "node --conditions=ripple-source src/cli/simulate.ts",
    "smoke:judge": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/smoke-judge.ts",
    "privacy": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/privacy.ts",
    "test:load": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/load.ts",
    "status": "node --env-file-if-exists=../../.env --conditions=ripple-source src/cli/status.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@ripple/contracts": "0.0.0",
    "@ripple/database": "0.0.0",
    "@ripple/engine": "0.0.0",
    "@types/pg": "8.23.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "ws": "8.20.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
