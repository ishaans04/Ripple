# Copy to .env for local development outside Docker. Never commit real secrets.

# Application database (the Compose `db` service is published on localhost:55432).
DATABASE_URL=postgres://ripple:ripple@localhost:55432/ripple

# Server listener.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time allowed to drain requests on shutdown before forcing exit.
SHUTDOWN_GRACE_MS=15000

# Built web application served by the API server (run `npm run build` first).
# Leave unset during development and use the Vite dev server on :5173 instead.
# WEB_ROOT=apps/web/dist

# Integration tests create and drop temporary databases through this connection.
TEST_DATABASE_URL=postgres://ripple:ripple@localhost:55432/postgres
