    "@ripple/database": "0.0.0",
    "@ripple/engine": "0.0.0",
    "@types/pg": "8.23.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
